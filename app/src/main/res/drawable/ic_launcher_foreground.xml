        </aapt:attr>
    </path>

    <!-- ichki halqa: uyqu (binafsha → ko'k) -->
    <path android:pathData="M54.00,41.00 A13,13 0 1,1 47.50,65.26" android:strokeWidth="6" android:strokeLineCap="round" android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
