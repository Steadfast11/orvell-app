    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- trek (chuqurcha) -->
    <path android:pathData="M32.00,54.00 a22,22 0 1,0 44.00,0 a22,22 0 1,0 -44.00,0" android:strokeWidth="6" android:strokeColor="#FFFFFF" android:strokeAlpha="0.08" android:fillColor="#00000000" />
    <path android:pathData="M41.00,54.00 a13,13 0 1,0 26.00,0 a13,13 0 1,0 -26.00,0" android:strokeWidth="6" android:strokeColor="#FFFFFF" android:strokeAlpha="0.08" android:fillColor="#00000000" />

    <!-- qiya orbita -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-28">
        <path android:pathData="M23,54 a31,11.5 0 1,0 62,0 a31,11.5 0 1,0 -62,0" android:strokeWidth="1.6" android:strokeAlpha="0.45" android:strokeColor="#45E3F2" android:fillColor="#00000000" />
