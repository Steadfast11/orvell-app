    <!-- Maxfiylik (ilova ichida; to'liq matn: docs/privacy/index.html) -->
    <string name="privacy_short_t">In short</string>
    <string name="privacy_short">Orvell does not sell your data, shows no ads and uses no tracking (analytics) libraries. By default all data stays only on your phone.</string>
    <string name="privacy_collect_t">What data is used</string>
    <string name="privacy_collect">From the watch: history records (saved on the phone), the watch\'s Bluetooth address and name. Steps, distance, calories and heart rate are decoded from the history records; sleep, blood oxygen (SpO2) and battery records are kept raw (not decoded yet). Steps, heart rate, blood oxygen, sleep and battery values saved by an earlier version stay on the phone and are not updated. Entered by you: name, sex, birth date, height, weight and goals.</string>
    <string name="privacy_store_t">Where it is stored</string>
    <string name="privacy_store">In the app\'s private storage on your phone. The app is excluded from backups (Google Backup). Orvell has no servers of its own.</string>
    <string name="privacy_share_t">Who receives it</string>
    <string name="privacy_share">No one — unless you turn something on. If you enable \"Your own server\", measurements go only to the address you enter. If you send feedback, the email goes through your own mail app.</string>
    <string name="privacy_permissions_t">Permissions</string>
    <string name="privacy_permissions">Nearby devices (Bluetooth) — to find and connect to the watch; on Android 11 and older the system requires the location permission for this, but Orvell does not determine your location. Notifications — for the watch connection and alerts. Run at startup — to restore the watch connection. Internet — only when your own server is enabled.</string>
    <string name="privacy_control_t">Your control</string>
    <string name="privacy_control">In Settings → Data you can export everything as CSV or delete it completely. Uninstalling the app also deletes all data.</string>
    <string name="privacy_medical_t">Medical notice</string>
    <string name="privacy_medical">Orvell is not a medical device. Readings are for information only and must not be used for diagnosis or treatment.</string>
    <string name="privacy_children_t">Children</string>
    <string name="privacy_children">The app is not intended for children under 13.</string>
    <string name="privacy_contact_t">Contact</string>
    <string name="privacy_contact">Questions: Settings → Feedback.</string>
    <string name="privacy_updated">Last updated: October 2026</string>

